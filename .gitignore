# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Claude Code local dev configs
.claude/

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Local environment — never commit secrets (GDOT keys, DB URLs, Stripe keys, etc.)
.env
.env.local
.env.*.local

# Business-confidential — prospect lists, sales notes, internal docs
# Anything in /private/ stays local; PROSPECTS.md is gitignored explicitly
# so an `git add -A` doesn't leak the cold-outbound target list.
/private/
PROSPECTS.md
PROSPECTS.*.md
*-PROSPECTS.md
DEVELOPERS.md
DEVELOPERS.*.md
DEVELOPER_CONTACTS.md
DEVELOPER_EMAILS.md
COLD_EMAIL_DEVELOPERS.md
SOLO_PES.md
GDOT_PREQUAL.md
*.xlsx

# Pre-extend snapshots written by scripts/src/extend-region-coverage.ts
# (large, regenerable from the source PBFs)
artifacts/api-server/src/data/_osm-archive/

# Ruflo/agent scratch state — never belongs in a commit (swept into a commit
# on 2026-08-19 despite explicit `git add` of unrelated paths).
ruvector.db
agentdb.rvf
agentdb.rvf.lock
.swarm/
.claude-flow/
**/ruvector.db
**/agentdb.rvf
**/agentdb.rvf.lock
**/.swarm/
**/.claude-flow/
