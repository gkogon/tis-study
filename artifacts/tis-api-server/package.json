{
  "name": "@workspace/tis-api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:diurnal-provenance": "node ./scripts/verify-diurnal-provenance.mjs",
    "check:isd-truck-gaps": "node ./scripts/verify-isd-truck-gaps.mjs",
    "check:screening-clamp": "node ./scripts/verify-screening-clamp.mjs",
    "check:trip-loading": "node ./scripts/verify-trip-loading.mjs",
    "check:caltran-gravity": "node ./scripts/verify-caltran-gravity.mjs",
    "check:trip-distribution": "node ./scripts/verify-trip-distribution.mjs",
    "check:uk-distribution": "node ./scripts/verify-uk-distribution.mjs",
    "smoke:distribution-pdf": "node ./scripts/smoke-distribution-pdf.mjs",
    "check:coverage-warning": "node ./scripts/verify-coverage-warning.mjs",
    "check:name-dedup": "node ./scripts/verify-name-dedup.mjs",
    "check:atlanta-msa-coverage": "node ./scripts/verify-atlanta-msa-coverage.mjs",
    "check:long-island-coverage": "node ./scripts/verify-long-island-coverage.mjs",
    "check:driveways": "node ./scripts/verify-driveways.mjs",
    "check:driveway-routing": "node ./scripts/verify-driveway-routing.mjs",
    "check:force-include": "node ./scripts/verify-force-include.mjs",
    "check:movement-assignment": "node ./scripts/verify-movement-assignment.mjs",
    "check:movement-loading": "node ./scripts/verify-movement-loading.mjs",
    "check:rate-auditability": "node ./scripts/verify-rate-auditability.mjs",
    "check:turn-ledger": "node ./scripts/verify-turn-ledger.mjs",
    "check:oneway-routing": "node ./scripts/verify-oneway-routing.mjs",
    "check:cordon-gateways": "node ./scripts/verify-cordon-gateways.mjs",
    "check:utdf-import": "node ./scripts/verify-utdf-import.mjs",
    "check:utdf-vigorous": "node ./scripts/verify-utdf-vigorous.mjs",
    "check:utdf-engine": "node ./scripts/verify-utdf-engine.mjs",
    "check:conserved-assignment": "node ./scripts/verify-conserved-assignment.mjs",
    "check:state-dispatch": "node ./scripts/verify-state-dispatch.mjs"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.13",
    "@workspace/db": "workspace:*",
    "@workspace/tis-api-zod": "workspace:*",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.3",
    "ioredis": "^5.11.1",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "pino": "^9",
    "pino-http": "^10",
    "rate-limit-redis": "^5.0.0",
    "resend": "^4.0.0",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.13.4",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
